        "source_evaluations": [{"evaluation_ref":"evaluation-exp-001","experiment_ref":"exp-001","validity":"valid","outcome":"positive","safety":"clear"}]
      },
      "expect": {"recommendation": "need_more_evidence", "must_flag_scope": true, "must_reduce_confidence": true}
    },
    {
